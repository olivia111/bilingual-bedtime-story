# Copy this file to .env and fill in your key.

# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (vision + text). gemini-2.5-flash is fast and cheap.
GEMINI_MODEL=gemini-2.5-flash

# TTS provider:
#   azure  = Azure AI Speech (free F0 tier; native multilingual zh-CN voices)
#   gemini = Gemini's native TTS (PAID per call)
#   edge   = Microsoft Edge TTS (free, limited voice catalog)
TTS_PROVIDER=azure

# Convert Chinese to tone-marked Pinyin before TTS (audio only; story still shows
# Chinese). Helps voices that get the tones wrong. Off for Azure's native voice.
TTS_PINYIN=false
# Wrap each Chinese run with ",," so the voice pauses around it (audio only).
TTS_PAD_CHINESE=true

# --- Azure AI Speech (used when TTS_PROVIDER=azure) ---
# Create a Speech resource in the Azure portal, then copy a key + its region.
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
# Native multilingual Chinese voice (great Chinese tones + English):
AZURE_TTS_VOICE=zh-CN-XiaoxiaoMultilingualNeural
# Speaking style (this voice supports: affectionate, cheerful, empathetic,
# excited, poetry-reading, sorry, story). Empty for none.
AZURE_TTS_STYLE=story
# When provider is azure, story generation can return narration with per-sentence
# mstts:express-as tags (SSML fragments), which Azure reads directly.
# Storytelling intensity (1.0 to 2.0). Empty to use provider default.
AZURE_TTS_STYLE_DEGREE=1.25
# Optional role for compatible voices.
AZURE_TTS_ROLE=Narrator
# Extra pause after sentence and clause punctuation, in milliseconds.
AZURE_TTS_SENTENCE_BREAK_MS=650
AZURE_TTS_CLAUSE_BREAK_MS=220

# --- Gemini TTS (used when TTS_PROVIDER=gemini) ---
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Prebuilt voices: Kore, Puck, Charon, Aoede, Leda, Zephyr, ... (~30 available)
GEMINI_TTS_VOICE=Kore
# A natural-language style instruction prepended to each section.
GEMINI_TTS_STYLE=Read in a warm, gentle, soothing bedtime voice, slowly and softly:

# --- Edge TTS (used when TTS_PROVIDER=edge) ---
# Multilingual voices speak both English and Chinese in one stream.
#   zh-CN-XiaoxiaoNeural          (native Chinese, accented English)
#   en-US-AvaMultilingualNeural   (warm female, good English, accented Chinese)
#   en-US-EmmaMultilingualNeural
TTS_VOICE=en-US-AvaMultilingualNeural
# Slow it down a touch for a soothing bedtime pace (e.g. -10%).
TTS_RATE=-10%
TTS_PITCH=+0Hz

# Per-client rate limits (slowapi syntax; combine windows with ";").
# Story generation calls the paid Gemini API, so keep it capped tighter.
RATE_LIMIT_STORY=10/minute;100/day
RATE_LIMIT_AUDIO=30/minute;300/day
